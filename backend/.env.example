# ─────────────────────────────────────────────
#  ApplyMate AI – Environment Configuration
# ─────────────────────────────────────────────
# Copy this file to .env and fill in real values

# Application
APP_NAME="ApplyMate AI"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-min-32-chars-here-change-this
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:5500","https://your-frontend.vercel.app"]

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/applymate_db

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Email (Brevo / Sendinblue)
BREVO_API_KEY=your-brevo-api-key-here
EMAIL_FROM=noreply@applymate.ai
EMAIL_FROM_NAME="ApplyMate AI"

# Admin credentials (change before deploying!)
ADMIN_EMAIL=admin@applymate.ai
ADMIN_PASSWORD=changeme-strong-password-here

# Scheduler
SCRAPER_INTERVAL_MINUTES=30

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# Railway (auto-set by Railway – do not edit)
# PORT=8000
